# Node 24 reads .env locally. Never commit it or share wallet URLs.
PORT=4317
WALLET_MODE=local-simulator
# Optional stable owner key, at least 32 random characters. Omit for a new key at each start.
# SATSPERMIT_OWNER_KEY=

# Optional real model. Without this, attack scenarios are labelled deterministic replays.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Optional NWC dummy-wallet integration (requires npm packages and network access).
# Run: npm ci
# Then: npm run sandbox
# Only use zero-value faucet credentials. The adapter was verified against NWC Faucet dummy wallets.
# WALLET_MODE=nwc-faucet
# NWC_FAUCET_ACK=dummy-funds-only
# NWC_PAYER_URL=
# NWC_MERCHANT_URL=
